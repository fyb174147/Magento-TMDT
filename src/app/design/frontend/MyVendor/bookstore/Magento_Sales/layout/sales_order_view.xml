<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <update handle="sales_order_item_renderers"/>
    <update handle="sales_order_item_price"/>
    <update handle="sales_order_info_links"/>
    <head>
        <title>Chi tiết đơn hàng</title>
        <css src="css/account-dashboard.css"/>
        <css src="css/order-view.css"/>
    </head>
    <body>
        <attribute name="class" value="account bookstore-account-custom order-view-page"/>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceBlock name="order.comments" remove="true"/>
        <referenceBlock name="sales.order.info.links" remove="true"/>
        <referenceBlock name="sales.order.view" template="Magento_Sales::order/view.phtml"/>
        <referenceBlock name="order_items" template="Magento_Sales::order/items.phtml"/>
        <referenceBlock name="sales.order.info" template="Magento_Sales::order/info.phtml"/>
    </body>
</page>
