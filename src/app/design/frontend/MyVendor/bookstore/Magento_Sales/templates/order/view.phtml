<?php
/**
 * @var \Magento\Sales\Block\Order\View $block
 * @var \Magento\Framework\Escaper $escaper
 */
$_order = $block->getOrder();
$statusClass = strtolower((string)$_order->getStatus());
?>
<div class="bookstore-order-view">
    <section class="order-view-hero">
        <div>
            <a class="order-view-back" href="<?= $escaper->escapeUrl($block->getBackUrl()) ?>">
                <?= $escaper->escapeHtml(__('Quay lại lịch sử đơn hàng')) ?>
            </a>
            <h1><?= $escaper->escapeHtml(__('Đơn hàng #%1', $_order->getRealOrderId())) ?></h1>
            <div class="order-view-meta">
                <span><?= $escaper->escapeHtml(__('Ngày đặt: %1', $block->formatDate($_order->getCreatedAt(), \IntlDateFormatter::LONG))) ?></span>
                <span class="order-view-status <?= $escaper->escapeHtmlAttr($statusClass) ?>">
                    <?= $escaper->escapeHtml(__($_order->getStatusLabel())) ?>
                </span>
            </div>
        </div>
        <div class="order-view-total">
            <span><?= $escaper->escapeHtml(__('Tổng thanh toán')) ?></span>
            <strong><?= /* @noEscape */ $_order->formatPrice($_order->getGrandTotal()) ?></strong>
        </div>
    </section>

    <section class="order-view-card order-view-products">
        <div class="order-view-card-title">
            <strong><?= $escaper->escapeHtml(__('Sản phẩm đã đặt')) ?></strong>
            <span><?= $escaper->escapeHtml(__('%1 sản phẩm', count($_order->getAllVisibleItems()))) ?></span>
        </div>

        <?= $block->getChildHtml('order_items') ?>
    </section>

    <?php if ($this->helper(\Magento\GiftMessage\Helper\Message::class)->isMessagesAllowed('order', $_order)
        && $_order->getGiftMessageId()
    ) : ?>
        <section class="order-view-card block-order-details-gift-message">
            <div class="order-view-card-title">
                <strong><?= $escaper->escapeHtml(__('Lời nhắn quà tặng')) ?></strong>
            </div>
            <?php $_giftMessage = $this->helper(\Magento\GiftMessage\Helper\Message::class)->getGiftMessageForEntity($_order); ?>
            <div class="block-content">
                <dl class="item-options">
                    <dt class="item-sender">
                        <strong class="label"><?= $escaper->escapeHtml(__('Từ')) ?></strong>
                        <?= $escaper->escapeHtml($_giftMessage->getSender()) ?>
                    </dt>
                    <dt class="item-recipient">
                        <strong class="label"><?= $escaper->escapeHtml(__('Đến')) ?></strong>
                        <?= $escaper->escapeHtml($_giftMessage->getRecipient()) ?>
                    </dt>
                    <dd class="item-message">
                        <?= /* @noEscape */ $this->helper(\Magento\GiftMessage\Helper\Message::class)->getEscapedGiftMessage($_order) ?>
                    </dd>
                </dl>
            </div>
        </section>
    <?php endif; ?>
</div>
