            <block class="Magento\Framework\View\Element\Template"
                   name="customer.account.edit.hero"
                   template="Magento_Theme::html/listing_hero.phtml"
                   before="-">
                <arguments>
                    <argument name="eyebrow" xsi:type="string">Tài khoản BookStore</argument>
                    <argument name="accent" xsi:type="string">#0095ff</argument>
                    <argument name="title" xsi:type="string">Chỉnh sửa thông tin</argument>
                    <argument name="description" xsi:type="string">Cập nhật thông tin cá nhân, email và mật khẩu của bạn tại BookStore.</argument>
                </arguments>
            </block>
            -->
            <block class="Magento\Customer\Block\Form\Edit" name="customer_edit" template="Magento_Customer::form/edit.phtml" cacheable="false">
                <arguments>
                    <argument name="button_lock_manager" xsi:type="object">Magento\Framework\View\Element\ButtonLockManager</argument>
                </arguments>
                <container name="form.additional.info" as="form_additional_info"/>
            </block>
        </referenceContainer>
    </body>
</page>