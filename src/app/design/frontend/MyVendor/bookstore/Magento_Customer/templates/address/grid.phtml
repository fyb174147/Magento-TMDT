<?php
/** @var \Magento\Customer\Block\Address\Grid $block */
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$addressBookBlock = $objectManager->get(\Magento\Customer\Block\Address\Book::class);
$additionalAddresses = $addressBookBlock->getAdditionalAddresses();

?>

<div class="bookstore-unified-account-card" style="margin-top: 24px;">
    <div class="bookstore-account-card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <strong>Địa chỉ giao hàng khác</strong>
        <button type="button" class="action add primary" style="background:#0095ff; color:#fff; border:none; padding:8px 16px; border-radius:6px; font-weight:600; cursor:pointer;" onclick="window.location='<?= $block->escapeUrl($addressBookBlock->getAddAddressUrl()) ?>'">
            <span>Thêm địa chỉ mới</span>
        </button>
    </div>

    <?php if ($additionalAddresses && count($additionalAddresses) > 0): ?>
        <div class="address-horizontal-container">
            <?php foreach ($additionalAddresses as $address): ?>
                <div class="address-horizontal-row-card">
                    <div class="address-row-text">
                        <?= $addressBookBlock->getAddressHtml($address) ?>
                    </div>
                    <div class="address-row-actions">
                        <button type="button"
                                class="address-row-action-button address-row-edit-button"
                                onclick="window.location='<?= $block->escapeUrl($addressBookBlock->getAddressEditUrl($address->getId())) ?>'">
                            <span>Sửa</span>
                        </button>
                        <button type="button"
                                class="address-row-action-button address-row-delete-button"
                                role="delete-address"
                                data-address="<?= $block->escapeHtmlAttr($address->getId()) ?>">
                            <span>Xóa</span>
                        </button>
                    </div>
                </div>
            <?php endforeach; ?>
        </div>
        <script type="text/x-magento-init">
            {
                ".page-main": {
                    "address": {
                        "deleteAddress": "button[role='delete-address']",
                        "deleteUrlPrefix": "<?= $block->escapeJs($block->escapeUrl($addressBookBlock->getDeleteUrl())) ?>id/",
                        "deleteConfirmMessage": "Bạn có chắc chắn muốn xóa địa chỉ này?"
                    }
                }
            }
        </script>
    <?php else: ?>
        <div class="empty-state" style="padding: 32px; text-align: center; color: #64748b;">
            <span>Bạn không có địa chỉ giao hàng nào khác.</span>
        </div>
    <?php endif; ?>
</div>
