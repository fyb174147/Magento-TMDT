<?php
/**
 * Custom compact address form for BookStore.
 *
 * @var \Magento\Customer\Block\Address\Edit $block
 * @var \Magento\Customer\ViewModel\Address $viewModel
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 */
$viewModel = $block->getViewModel();
$customer = $block->getCustomer();
$address = $block->getAddress();

$firstname = (string)($customer ? $customer->getFirstname() : $address->getFirstname());
$lastname = (string)($customer ? $customer->getLastname() : $address->getLastname());

$_telephone = $block->getLayout()->createBlock(\Magento\Customer\Block\Widget\Telephone::class);
$_country = $block->getAttributeData()->getFrontendLabel('country_id');
$_street = $block->getAttributeData()->getFrontendLabel('street');
$_city = $block->getAttributeData()->getFrontendLabel('city');
$_postcode = $block->getAttributeData()->getFrontendLabel('postcode');
$_telephoneValidationClass = $_telephone->isRequired() ? 'required-entry' : '';
$_streetValidationClass = $viewModel->addressGetAttributeValidationClass('street');
$_cityValidationClass = $viewModel->addressGetAttributeValidationClass('city');
$_postcodeValidationClass = $viewModel->addressGetAttributeValidationClass('postcode');
$regionValue = $block->getRegion() ?: $address->getCity();
?>

<form class="form-address-edit bookstore-compact-address-form"
      action="<?= $escaper->escapeUrl($block->getSaveUrl()) ?>"
      method="post"
      id="form-validate"
      enctype="multipart/form-data"
      data-hasrequired="<?= $escaper->escapeHtmlAttr(__('* Required Fields')) ?>">
    <?= $block->getBlockHtml('formkey') ?>
    <input type="hidden" name="success_url" value="<?= $escaper->escapeUrl($block->getSuccessUrl()) ?>">
    <input type="hidden" name="error_url" value="<?= $escaper->escapeUrl($block->getErrorUrl()) ?>">
    <input type="hidden" name="firstname" value="<?= $escaper->escapeHtmlAttr($firstname) ?>">
    <input type="hidden" name="lastname" value="<?= $escaper->escapeHtmlAttr($lastname) ?>">
    <input type="hidden" name="default_billing" value="1">
    <input type="hidden" name="default_shipping" value="1">
    <input type="hidden" id="region_id" name="region_id" value="<?= (int)$block->getRegionId() ?>">
    <input type="hidden" id="region" name="region" value="<?= $escaper->escapeHtmlAttr($regionValue) ?>">

    <fieldset class="fieldset contact-fields">
        <legend class="legend"><span><?= $escaper->escapeHtml(__('Thông tin liên hệ')) ?></span></legend>
        <?php if ($_telephone->isEnabled()): ?>
            <div class="field telephone <?= $_telephone->isRequired() ? 'required' : '' ?>">
                <label class="label" for="telephone">
                    <span><?= $escaper->escapeHtml(__('Số điện thoại')) ?></span>
                </label>
                <div class="control">
                    <input type="tel"
                           name="telephone"
                           id="telephone"
                           value="<?= $escaper->escapeHtmlAttr($address->getTelephone()) ?>"
                           title="<?= $escaper->escapeHtmlAttr(__('Số điện thoại')) ?>"
                           class="input-text <?= $escaper->escapeHtmlAttr($_telephoneValidationClass) ?>">
                </div>
            </div>
        <?php endif; ?>
    </fieldset>

    <fieldset class="fieldset address-fields">
        <legend class="legend"><span><?= $escaper->escapeHtml(__('Địa chỉ giao hàng')) ?></span></legend>

        <div class="field street required">
            <label for="street_1" class="label">
                <span><?= $escaper->escapeHtml($_street) ?></span>
            </label>
            <div class="control">
                <input type="text"
                       name="street[0]"
                       value="<?= $escaper->escapeHtmlAttr($block->getStreetLine(1)) ?>"
                       title="<?= $escaper->escapeHtmlAttr($_street) ?>"
                       id="street_1"
                       class="input-text <?= $escaper->escapeHtmlAttr($_streetValidationClass) ?>">
            </div>
        </div>

        <div class="field country required">
            <label class="label" for="country">
                <span><?= $escaper->escapeHtml($_country) ?></span>
            </label>
            <div class="control">
                <?= $block->getCountryHtmlSelect() ?>
            </div>
        </div>

        <div class="field city required">
            <label class="label" for="city">
                <span><?= $escaper->escapeHtml($_city) ?></span>
            </label>
            <div class="control">
                <input type="text"
                       name="city"
                       value="<?= $escaper->escapeHtmlAttr($address->getCity()) ?>"
                       title="<?= $escaper->escapeHtmlAttr($_city) ?>"
                       class="input-text <?= $escaper->escapeHtmlAttr($_cityValidationClass) ?>"
                       id="city">
            </div>
        </div>

        <div class="field zip required">
            <label class="label" for="zip">
                <span><?= $escaper->escapeHtml($_postcode) ?></span>
            </label>
            <div class="control">
                <input type="text"
                       name="postcode"
                       value="<?= $escaper->escapeHtmlAttr($address->getPostcode()) ?>"
                       title="<?= $escaper->escapeHtmlAttr($_postcode) ?>"
                       id="zip"
                       class="input-text validate-zip-international <?= $escaper->escapeHtmlAttr($_postcodeValidationClass) ?>">
                <div role="alert" class="message warning">
                    <span></span>
                </div>
                <?= /* @noEscape */ $secureRenderer->renderStyleAsTag("display: none;", 'div.message.warning') ?>
            </div>
        </div>
    </fieldset>

    <div class="actions-toolbar">
        <div class="primary">
            <button type="submit"
                    class="action save primary"
                    data-action="save-address"
                    title="<?= $escaper->escapeHtmlAttr(__('Lưu địa chỉ')) ?>">
                <span><?= $escaper->escapeHtml(__('Lưu địa chỉ')) ?></span>
            </button>
        </div>
        <div class="secondary">
            <a class="action back" href="<?= $escaper->escapeUrl($block->getBackUrl()) ?>">
                <span><?= $escaper->escapeHtml(__('Quay lại')) ?></span>
            </a>
        </div>
    </div>
</form>

<script type="text/x-magento-init">
    {
        "#form-validate": {
            "addressValidation": {
                "postCodes": <?= /* @noEscape */ $block->getPostCodeConfig()->getSerializedPostCodes() ?>
            }
        }
    }
</script>
<script>
require(['jquery'], function ($) {
    'use strict';

    var $city = $('#city');
    var $region = $('#region');

    function syncRegionFromCity() {
        if (!$region.val()) {
            $region.val($city.val());
        }
    }

    $city.on('input change', syncRegionFromCity);
    $('#form-validate').on('submit', syncRegionFromCity);
});
</script>
