<?php
/** @var \Magento\Framework\View\Element\Template $block */

// 1. Khởi tạo ObjectManager và các dịch vụ lấy thông tin khách hàng
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$customerSession = $objectManager->get(\Magento\Customer\Model\Session::class);

$currentCustomer = $customerSession->getCustomer();
$fullName = '';
$firstName = '';
$email = '';
if ($currentCustomer && $currentCustomer->getId()) {
    $firstName = $currentCustomer->getFirstname();
    $fullName = $firstName . ' ' . $currentCustomer->getLastname();
    $email = $currentCustomer->getEmail();
}

$avatarLetter = $firstName ? mb_strtoupper(mb_substr($firstName, 0, 1)) : 'U';

$defaultShippingAddress = $currentCustomer ? $currentCustomer->getDefaultShippingAddress() : null;
$addressLines = [];
$hasAddress = false;
$addressPhone = '';

if ($defaultShippingAddress) {
    try {
        $street = $defaultShippingAddress->getStreet();
        $streetString = is_array($street) ? implode(', ', $street) : $street;
        if ($streetString) $addressLines[] = $block->escapeHtml($streetString);
        
        $cityPart = '';
        if ($defaultShippingAddress->getCity()) $cityPart .= $block->escapeHtml($defaultShippingAddress->getCity());
        if ($defaultShippingAddress->getRegion()) $cityPart .= ($cityPart ? ', ' : '') . $block->escapeHtml($defaultShippingAddress->getRegion());
        if ($cityPart) $addressLines[] = $cityPart;
        
        $addressLines[] = $defaultShippingAddress->getCountryId() === 'VN' ? 'Việt Nam' : $block->escapeHtml($defaultShippingAddress->getCountryId());
        if ($defaultShippingAddress->getTelephone()) {
            $addressPhone = $block->escapeHtml($defaultShippingAddress->getTelephone());
        }
        $hasAddress = true;
    } catch (\Exception $e) {
        $hasAddress = false;
    }
}

// Đã fix lỗi cú pháp: Thêm dấu chấm phẩy (;) vào cuối dòng dưới đây
$editAddressUrl = $block->getUrl('customer/address/');
if ($defaultShippingAddress) {
    $editAddressUrl = $block->getUrl('customer/address/edit', ['id' => $defaultShippingAddress->getId()]);
}
