<script>
require(['jquery'], function($) {
    $(document).ready(function() {
        $('.user-trigger').on('click', function(e) {
            e.stopPropagation();
            $(this).parent('.user-account-wrapper').toggleClass('active');
        });

        $(document).on('click', function() {
            $('.user-account-wrapper').removeClass('active');
        });

        $('.user-dropdown-menu').on('click', function(e) {
            e.stopPropagation();
        });
    });
});
</script>

