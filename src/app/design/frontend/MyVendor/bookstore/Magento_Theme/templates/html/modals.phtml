<script>
    /**
     * Chuyển đổi giữa tab Đăng nhập và Đăng ký
     */
    window.switchAuth = function(type) {
        const loginTab = document.getElementById('loginTab');
        const registerTab = document.getElementById('registerTab');
        const loginView = document.getElementById('loginView');
        const registerView = document.getElementById('registerView');

        if (type === 'login') {
            loginTab.classList.add('active');
            registerTab.classList.remove('active');
            loginView.classList.add('active');
            registerView.classList.remove('active');
        } else {
            registerTab.classList.add('active');
            loginTab.classList.remove('active');
            registerView.classList.add('active');
            loginView.classList.remove('active');
        }
    };

    /**
     * Mở Modal Đăng nhập/Đăng ký
     */
    window.openModal = function(type) {
        const modal = document.getElementById('authModal');
        if (modal) {
            modal.classList.add('active');
            window.switchAuth(type);
            document.body.style.overflow = 'hidden'; // Chặn cuộn trang
        }
    };

    /**
     * Đóng Modal Đăng nhập
     */
    window.closeModal = function() {
        const modal = document.getElementById('authModal');
        if (modal) {
            modal.classList.remove('active');
            document.body.style.overflow = '';
        }
    };

    /**
     * Điều khiển Giỏ hàng trượt
     */
    window.toggleCart = function(isOpen) {
        const cart = document.getElementById('cart-sidebar');
        if (cart) {
            if (isOpen) {
                cart.classList.add('active');
                document.body.style.overflow = 'hidden';
            } else {
                cart.classList.remove('active');
                document.body.style.overflow = '';
            }
        }
    };

    /**
     * Đóng tất cả khi nhấn phím ESC
     */
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            window.closeModal();
            window.toggleCart(false);
        }
    });

    /**
     * Đóng modal khi click ra ngoài vùng trắng (overlay)
     */
    window.addEventListener('click', function(e) {
        const authModal = document.getElementById('authModal');
        if (e.target === authModal) {
            window.closeModal();
        }
    });
</script>