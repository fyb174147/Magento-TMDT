<?php
/**
 * Template widget Sách mới + Nhãn giảm giá
 * @var $block \Magento\Catalog\Block\Product\Widget\NewWidget
 */
if ($exist = ($block->getProductCollection() && $block->getProductCollection()->getSize())) {
    $type = 'widget-new-grid';
    $mode = 'grid';
    $image = 'new_products_content_widget_grid';
    $allItems = array_values($block->getProductCollection()->getItems());
    $pageSize = 12;
    $currentPage = max(1, (int)$block->getRequest()->getParam('p', 1));
    $totalItems = count($allItems);
    $totalPages = max(1, (int)ceil($totalItems / $pageSize));
    $currentPage = min($currentPage, $totalPages);
    $items = array_slice($allItems, ($currentPage - 1) * $pageSize, $pageSize);
    $pageUrl = function (int $page) use ($block) {
        return $block->getUrl('*/*/*', [
            '_current' => true,
            '_use_rewrite' => true,
            '_query' => ['p' => $page],
        ]);
    };
}
?>

<?php if ($exist) :?>
    <div class="block widget block-new-products <?= $mode ?>">
        <div class="block-content">
            <div class="products-<?= $mode ?> <?= $mode ?>">
                <ol class="product-items <?= $type ?>">
                    <?php foreach ($items as $_item) :?>
                        <?php 
                            // 1. TÍNH TOÁN % GIẢM GIÁ
                            $price = $_item->getPrice();
                            $specialPrice = $_item->getSpecialPrice();
                            $discount = 0;
                            if ($specialPrice > 0 && $price > $specialPrice) {
                                $discount = round((($price - $specialPrice) / $price) * 100);
                            }
                            
                            // 2. GÁN CLASS ĐỂ CSS VIỀN (CAM NẾU SALE, XANH NẾU MỚI)
                            $itemClass = ($discount > 0) ? 'is-sale-item' : 'is-new-item';
                        ?>
                        <li class="product-item <?= $itemClass ?>">
                            <div class="product-item-info">
                                <div class="product-photo-container">
                                    <a href="<?= $block->escapeUrl($block->getProductUrl($_item)) ?>" class="product-item-photo">
                                        <?= $block->getImage($_item, $image)->toHtml() ?>
                                    </a>
                                    <?php if ($discount > 0): ?>
                                        <div class="product-badge-sale">-<?= $discount ?>%</div>
                                    <?php endif; ?>
                                </div>
                                
                                <div class="product-item-details">
                                    <strong class="product-item-name">
                                        <a title="<?= $block->escapeHtml($_item->getName()) ?>"
                                           href="<?= $block->escapeUrl($block->getProductUrl($_item)) ?>"
                                           class="product-item-link">
                                            <?= $block->escapeHtml($_item->getName()) ?>
                                        </a>
                                    </strong>
                                    
                                    <div class="price-box">
                                        <?= $block->getProductPriceHtml($_item, $type); ?>
                                    </div>

                                    <div class="product-item-actions">
                                        <div class="actions-primary">
                                            <?php if ($_item->isSaleable()) :?>
                                                <?php
                                                    $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
                                                    $postDataHelper = $objectManager->get(\Magento\Framework\Data\Helper\PostHelper::class);
                                                    $postData = $postDataHelper->getPostData(
                                                        $block->escapeUrl($block->getAddToCartUrl($_item)),
                                                        ['product' => (int) $_item->getEntityId()]
                                                    )
                                                ?>
                                                <button class="action tocart primary" data-post='<?= $postData ?>' type="button">
                                                    <span><?= __('Thêm vào giỏ') ?></span>
                                                </button>
                                            <?php endif; ?>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </li>
                    <?php endforeach ?>
                </ol>
                <nav class="bookstore-pagination" aria-label="<?= $block->escapeHtmlAttr(__('Phân trang')) ?>">
                    <div class="bookstore-page-status">
                        <?= $block->escapeHtml(__('Trang %1 của %2', $currentPage, $totalPages)) ?>
                    </div>
                    <div class="bookstore-page-actions">
                        <a class="bookstore-page-link<?= $currentPage <= 1 ? ' is-disabled' : '' ?>" href="<?= $block->escapeUrl($pageUrl(1)) ?>" data-tooltip="<?= $block->escapeHtmlAttr(__('Trang đầu')) ?>" title="<?= $block->escapeHtmlAttr(__('Trang đầu')) ?>">&#171;</a>
                        <a class="bookstore-page-link<?= $currentPage <= 1 ? ' is-disabled' : '' ?>" href="<?= $block->escapeUrl($pageUrl(max(1, $currentPage - 1))) ?>" data-tooltip="<?= $block->escapeHtmlAttr(__('Trang trước')) ?>" title="<?= $block->escapeHtmlAttr(__('Trang trước')) ?>">&#8249;</a>
                        <a class="bookstore-page-link<?= $currentPage >= $totalPages ? ' is-disabled' : '' ?>" href="<?= $block->escapeUrl($pageUrl(min($totalPages, $currentPage + 1))) ?>" data-tooltip="<?= $block->escapeHtmlAttr(__('Trang sau')) ?>" title="<?= $block->escapeHtmlAttr(__('Trang sau')) ?>">&#8250;</a>
                        <a class="bookstore-page-link<?= $currentPage >= $totalPages ? ' is-disabled' : '' ?>" href="<?= $block->escapeUrl($pageUrl($totalPages)) ?>" data-tooltip="<?= $block->escapeHtmlAttr(__('Trang cuối')) ?>" title="<?= $block->escapeHtmlAttr(__('Trang cuối')) ?>">&#187;</a>
                    </div>
                </nav>
            </div>
        </div>
    </div>
<?php endif;?>
