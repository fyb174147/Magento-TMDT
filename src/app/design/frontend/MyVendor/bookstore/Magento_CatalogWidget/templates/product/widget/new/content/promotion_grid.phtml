        /* 4. NHUỘM MÀU CAM CHO THANH LỌC BÊN TRÁI (CHUẨN CLASS) */
        .cms-promotions .sidebar-main .filter-sidebar { border: 2px solid #ff4d00 !important; border-radius: 12px !important; padding: 16px !important; background: #fff !important; }
        .cms-promotions .sidebar-main .filter-sidebar .filter-options-title { color: #ff4d00 !important; font-weight: 800 !important; }
        .cms-promotions .sidebar-main .filter-sidebar .action.primary { background: #ff4d00 !important; border-color: #ff4d00 !important; color: #fff !important; border-radius: 8px !important; width: 100%; height: 40px;}
        .cms-promotions .sidebar-main .filter-sidebar .action.primary:hover { filter: brightness(0.9); }
        .cms-promotions .sidebar-main .filter-sidebar .ui-slider-range { background: #ff4d00 !important; }
