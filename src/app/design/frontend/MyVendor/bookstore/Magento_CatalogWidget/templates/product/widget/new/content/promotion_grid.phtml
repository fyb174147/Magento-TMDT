<?php
/** @var \Magento\CatalogWidget\Block\Product\ProductsList $block */
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$postDataHelper = $objectManager->get(\Magento\Framework\Data\Helper\PostHelper::class);
$customerSession = $objectManager->get(\Magento\Customer\Model\Session::class);
$isLoggedIn = $customerSession->isLoggedIn();

if ($exist = ($block->getProductCollection() && $block->getProductCollection()->getSize())) {
    $allItems = array_values($block->getProductCollection()->getItems());
    
    // BỘ LỌC CƯỠNG CHẾ: Chỉ lấy sách có Khuyến mãi (Giá cuối < Giá gốc)
    $promoItems = array_filter($allItems, function($_product) {
        $regular = (float)$_product->getPrice();
        $final = (float)$_product->getFinalPrice();
        return ($final < $regular && $final > 0);
    });
    $promoItems = array_values($promoItems);

    $pageSize = 12;
    $currentPage = max(1, (int)$block->getRequest()->getParam('p', 1));
    $totalItems = count($promoItems);
    $totalPages = max(1, (int)ceil($totalItems / $pageSize));
    $currentPage = min($currentPage, $totalPages);
    $items = array_slice($promoItems, ($currentPage - 1) * $pageSize, $pageSize);
    $pageUrl = function (int $page) use ($block) {
        return $block->getUrl('*/*/*', ['_current' => true, '_use_rewrite' => true, '_query' => ['p' => $page]]);
    };
    $exist = count($items) > 0;
}
?>

<?php if ($exist): ?>
    <style>
        /* 1. XÓA KHOẢNG TRẮNG ĐẦU TRANG & ẨN TITLE THỪA */
        .cms-promotions .page-main { padding-top: 0 !important; margin-top: 0 !important; max-width: 1200px !important; margin: 0 auto !important; }
        .cms-promotions .page-title-wrapper { display: none !important; }
        .cms-promotions .block.widget .block-title { display: none !important; }

        /* 2. ÉP LAYOUT 2 CỘT CHUẨN XÁC */
        .cms-promotions .catalog-search-container { display: flex !important; gap: 28px !important; align-items: flex-start !important; width: 100% !important; margin-top: 0 !important;}
        .cms-promotions .sidebar.sidebar-main { flex: 0 0 25% !important; min-width: 240px !important; width: 25% !important; margin-top: 0 !important; }
        .cms-promotions .search-results-content { flex: 1 1 72% !important; width: 72% !important; min-width: 0 !important; margin-top: 0 !important; }

        /* 3. TIÊU DIỆT KHOẢNG TRẮNG DO MAGENTO TỰ SINH */
