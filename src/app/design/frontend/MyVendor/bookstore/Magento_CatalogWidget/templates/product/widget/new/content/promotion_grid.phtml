        /* 5. LƯỚI SẢN PHẨM KHÔNG BỊ BÓP DỌC (Căn theo dạng trang Tất cả sách) */
        .cms-promotions .product-items.products-grid { display: grid !important; grid-template-columns: repeat(3, 1fr) !important; gap: 24px !important; width: 100% !important; max-width: 100% !important; margin: 0 !important; padding: 0 !important; list-style: none !important; }
        .cms-promotions .product-item { width: 100% !important; max-width: none !important; margin: 0 !important; border: 2px solid #ff4d00 !important; border-radius: 16px !important; box-sizing: border-box !important; float: none !important; }
        .cms-promotions .action.tocart { background: #ff4d00 !important; color: #fff !important; border: none !important; }
        .cms-promotions .action.tocart:hover { filter: brightness(0.9); }
        .cms-promotions .action.tocart.is-login-required,
        .cms-promotions .action.tocart.is-login-required:hover { background: #cbd5e1 !important; color: #64748b !important; filter: none !important; cursor: not-allowed !important; box-shadow: none !important; }

        /* 6. CĂN GIỮA PHÂN TRANG */
        .bookstore-pagination { display: flex; justify-content: center; align-items: center; margin-top: 30px; border-top: 1px solid #e2e8f0; padding-top: 20px; clear: both; width: 100%; }
        .bookstore-pagination .bookstore-page-actions { display: flex; gap: 8px; margin-left: 15px; }
        .bookstore-pagination .bookstore-page-link { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 10px; font-weight: bold; text-decoration: none; border: 2px solid #ff4d00; color: #ff4d00; transition: 0.3s; }
        .bookstore-pagination .bookstore-page-link:hover:not(.is-disabled) { background: #ff4d00; color: #fff; }
        .bookstore-pagination .bookstore-page-link.is-disabled { border-color: #cbd5e1; color: #94a3b8; pointer-events: none; }
    </style>

    <div class="bookstore-grid-wrapper block widget">
        <div class="block-content">
            <div class="product-items products-grid">
                <?php foreach ($items as $_product): ?>
                    <?php
                        $regularPrice = (float)$_product->getPrice();
                        $finalPrice = (float)$_product->getFinalPrice();
                        $postData = $postDataHelper->getPostData(
                            $block->escapeUrl($block->getAddToCartUrl($_product)),
                            ['product' => (int)$_product->getEntityId()]
                        );
                    ?>
                    <div class="book-card product-item">
                        <div class="product-item-info">
                            <div class="product-photo-container">
                                <a href="<?= $block->escapeUrl($_product->getProductUrl()) ?>" class="product-item-photo">
                                    <img src="<?= $block->escapeUrl($block->getImage($_product, 'category_page_grid')->getImageUrl()) ?>"
                                         alt="<?= $block->escapeHtmlAttr($_product->getName()) ?>" style="width: 100%; height: auto; aspect-ratio: 3/4; object-fit: contain;">
                                </a>
                            </div>

                            <div class="product-item-details" style="display: flex; flex-direction: column; flex: 1; padding-top: 12px; justify-content: space-between;">
                                <strong class="product-item-name" style="min-height: 44px; margin-bottom: 8px;">
                                    <a href="<?= $block->escapeUrl($_product->getProductUrl()) ?>" class="product-item-link" style="color: var(--text-main); font-weight: 700; text-decoration: none;">
                                        <?= $block->escapeHtml($_product->getName()) ?>
                                    </a>
                                </strong>

                                <div class="price-box" style="min-height: 40px; margin-bottom: 12px;">
                                    <?php if ($regularPrice > $finalPrice): ?>
                                        <span class="old-price" style="text-decoration: line-through; color: #94a3b8; font-size: 13px; display: block; margin-bottom: 4px;">
                                            <?= number_format($regularPrice, 0, ',', '.') ?> đ
                                        </span>
                                    <?php endif; ?>
                                    <span class="price" style="font-weight: 900; font-size: 16px;">
                                        <?= number_format($finalPrice, 0, ',', '.') ?> đ
                                    </span>
                                </div>

                                <div class="product-item-actions" style="margin-top: auto;">
                                    <?php if ($_product->isSaleable()): ?>
                                        <?php if ($isLoggedIn): ?>
                                            <button class="action tocart primary"
                                                    data-post='<?= $block->escapeHtmlAttr($postData) ?>'
                                                    type="button" style="width: 100%; height: 42px; border-radius: 10px; font-weight: 800; cursor: pointer;">
                                                <span><?= __('Thêm vào giỏ') ?></span>
                                            </button>
                                        <?php else: ?>
                                            <span class="login-required-tooltip"
                                                  data-tooltip="<?= $block->escapeHtmlAttr(__('bạn cần phải đăng nhập để mua hàng')) ?>">
                                                <button class="action tocart primary is-login-required"
                                                        type="button"
                                                        disabled
                                                        aria-disabled="true"
                                                        title="<?= $block->escapeHtmlAttr(__('bạn cần phải đăng nhập để mua hàng')) ?>"
                                                        style="width: 100%; height: 42px; border-radius: 10px; font-weight: 800; cursor: not-allowed;">
                                                    <span><?= __('Thêm vào giỏ') ?></span>
                                                </button>
                                            </span>
                                        <?php endif; ?>
                                    <?php endif; ?>
                                </div>
                            </div>
                        </div>
                    </div>
                <?php endforeach; ?>
            </div>

            <nav class="bookstore-pagination" aria-label="<?= $block->escapeHtmlAttr(__('Phân trang')) ?>">
                <div class="bookstore-page-status">
                    <?= $block->escapeHtml(__('Trang %1 của %2', $currentPage, $totalPages)) ?>
                </div>
                <div class="bookstore-page-actions">
                    <a class="bookstore-page-link<?= $currentPage <= 1 ? ' is-disabled' : '' ?>" href="<?= $block->escapeUrl($pageUrl(1)) ?>">&#171;</a>
                    <a class="bookstore-page-link<?= $currentPage <= 1 ? ' is-disabled' : '' ?>" href="<?= $block->escapeUrl($pageUrl(max(1, $currentPage - 1))) ?>">&#8249;</a>
                    <a class="bookstore-page-link<?= $currentPage >= $totalPages ? ' is-disabled' : '' ?>" href="<?= $block->escapeUrl($pageUrl(min($totalPages, $currentPage + 1))) ?>">&#8250;</a>
                    <a class="bookstore-page-link<?= $currentPage >= $totalPages ? ' is-disabled' : '' ?>" href="<?= $block->escapeUrl($pageUrl($totalPages)) ?>">&#187;</a>
                </div>
            </nav>
        </div>
    </div>
<?php else: ?>
    <div class="message info empty"><div><?= __('Hiện tại không có chương trình khuyến mãi nào.') ?></div></div>
<?php endif; ?>
