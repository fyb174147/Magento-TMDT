<?php
/**
 * Search Results Filter Sidebar
 * Hỗ trợ lọc: Danh mục, Khoảng giá
 * @var $block \Magento\Framework\View\Element\Template
 */

$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$categoryCollectionFactory = $objectManager->get(\Magento\Catalog\Model\ResourceModel\Category\CollectionFactory::class);
$productCollectionFactory = $objectManager->get(\Magento\Catalog\Model\ResourceModel\Product\CollectionFactory::class);
$productStatus = $objectManager->get(\Magento\Catalog\Model\Product\Attribute\Source\Status::class);
$productVisibility = $objectManager->get(\Magento\Catalog\Model\Product\Visibility::class);
$categoryCollection = $categoryCollectionFactory->create()
    ->addAttributeToSelect('name')
    ->addAttributeToFilter('is_active', 1)
    ->addAttributeToFilter('level', ['gt' => 1])
    ->setOrder('position', 'ASC');

$request = $block->getRequest();
$selectedCategory = (int)$request->getParam('cat', 0);
$queryText = trim((string)$request->getParam('q', ''));
$priceParam = $request->getParam('price');
$minPrice = 0;
$maxPrice = 5000000;

if (is_array($priceParam)) {
    $minPrice = isset($priceParam['from']) ? (int)$priceParam['from'] : $minPrice;
    $maxPrice = isset($priceParam['to']) ? (int)$priceParam['to'] : $maxPrice;
} elseif (is_string($priceParam) && strpos($priceParam, '-') !== false) {
    [$from, $to] = array_pad(explode('-', $priceParam, 2), 2, null);
    $minPrice = (int)$from;
    $maxPrice = $to !== null && $to !== '' ? (int)$to : $maxPrice;
}

$applySearchFilter = static function ($collection) use ($queryText) {
    if ($queryText === '') {
        return;
    }

    $likeQuery = '%' . $queryText . '%';
    $collection->addAttributeToFilter([
        ['attribute' => 'name', 'like' => $likeQuery],
        ['attribute' => 'sku', 'like' => $likeQuery],
    ]);
};

$countProducts = static function (?int $categoryId = null) use (
    $productCollectionFactory,
    $productStatus,
    $productVisibility,
    $applySearchFilter
) {
    $collection = $productCollectionFactory->create()
        ->addAttributeToSelect('entity_id')
        ->addAttributeToFilter('status', ['in' => $productStatus->getVisibleStatusIds()])
        ->setVisibility($productVisibility->getVisibleInSiteIds())
        ->addStoreFilter();

    if ($categoryId) {
        $collection->addCategoriesFilter(['in' => [$categoryId]]);
    }

    $applySearchFilter($collection);

    return (int)$collection->getSize();
};

$allCategoryCount = $countProducts(null);
?>

<div class="filter-sidebar">
    <div class="filter-header">
        <h2><?= __('Bộ lọc') ?></h2>
    </div>

    <div class="filter-section filter-category">
        <div class="filter-title">
            <span><?= __('Danh mục') ?></span>
            <button type="button" class="filter-toggle">▼</button>
        </div>
        <div class="filter-content">
            <div class="category-filter-list">
                <label class="filter-option">
                    <input type="radio" name="cat" value="" <?= $selectedCategory === 0 ? 'checked' : '' ?> onchange="filterSearch()"> 
                    <span><?= __('Tất cả danh mục') ?> (<?= (int)$allCategoryCount ?>)</span>
                </label>
                <?php foreach ($categoryCollection as $category): ?>
                    <?php $categoryProductCount = $countProducts((int)$category->getId()); ?>
                    <label class="filter-option">
                        <input type="radio" name="cat" value="<?= (int)$category->getId() ?>"
                               <?= $selectedCategory === (int)$category->getId() ? 'checked' : '' ?>
                               onchange="filterSearch()"> 
                        <span><?= $block->escapeHtml($category->getName()) ?> (<?= (int)$categoryProductCount ?>)</span>
                    </label>
                <?php endforeach; ?>
            </div>
        </div>
    </div>

    <div class="filter-section filter-price">
        <div class="filter-title">
            <span><?= __('Khoảng giá') ?></span>
            <button type="button" class="filter-toggle">▼</button>
        </div>
        <div class="filter-content">
            <div class="price-filter-wrapper">
                <div class="price-inputs">
                    <div class="price-input-group">
                        <label><?= __('Từ') ?> (₫)</label>
                        <input type="number" id="priceFromInput" min="0" value="<?= (int)$minPrice ?>" 
                               placeholder="0" onchange="updatePriceRange()" 
                               class="price-input">
                    </div>
                    <div class="price-input-group">
                        <label><?= __('Đến') ?> (₫)</label>
                        <input type="number" id="priceToInput" min="0" value="<?= (int)$maxPrice ?>" 
                               placeholder="5000000" onchange="updatePriceRange()" 
                               class="price-input">
                    </div>
                </div>

                <div class="price-slider-container" id="priceSliderContainer">
                    <div class="price-slider-track">
                        <div class="price-slider-fill"></div>
                    </div>
                    <input type="range" id="priceSliderFrom" min="0" max="5000000" 
                           value="<?= (int)$minPrice ?>" class="price-slider">
                    <input type="range" id="priceSliderTo" min="0" max="5000000" 
                           value="<?= (int)$maxPrice ?>" class="price-slider">
                </div>

                <div class="price-output">
                    <span id="priceDisplay">
                        <?= __('Từ') ?> <strong><?= number_format($minPrice, 0, ',', '.') ?>₫</strong> 
                        <?= __('đến') ?> 
                        <strong><?= number_format($maxPrice, 0, ',', '.') ?>₫</strong>
                    </span>
                </div>

                <button type="button" class="btn-apply-price" onclick="filterSearch()">
                    <?= __('Áp dụng') ?>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    var priceFrom = parseInt(document.getElementById('priceFromInput').value);
    var priceTo = parseInt(document.getElementById('priceToInput').value);

    // Xử lý Range Slider
    function handlePriceSliders() {
        var sliderFrom = document.getElementById('priceSliderFrom');
        var sliderTo = document.getElementById('priceSliderTo');
        var inputFrom = document.getElementById('priceFromInput');
        var inputTo = document.getElementById('priceToInput');

        var from = parseInt(sliderFrom.value);
        var to = parseInt(sliderTo.value);

        // Đảm bảo giá trị "từ" không lớn hơn "đến"
        if (from > to) {
            var temp = from;
            from = to;
            to = temp;
            sliderFrom.value = from;
            sliderTo.value = to;
        }

        inputFrom.value = from;
        inputTo.value = to;

        // Update Fill Color
        var sliderTrack = document.querySelector('.price-slider-track');
        var fill = document.querySelector('.price-slider-fill');
        var min = parseInt(sliderFrom.min);
        var max = parseInt(sliderFrom.max);
        
        var percentage1 = ((from - min) / (max - min)) * 100;
        var percentage2 = ((to - min) / (max - min)) * 100;
        
        fill.style.left = percentage1 + '%';
        fill.style.right = (100 - percentage2) + '%';

        updatePriceDisplay();
    }

    function updatePriceRange() {
        var sliderFrom = document.getElementById('priceSliderFrom');
        var sliderTo = document.getElementById('priceSliderTo');
        var inputFrom = document.getElementById('priceFromInput');
        var inputTo = document.getElementById('priceToInput');

        sliderFrom.value = Math.max(0, parseInt(inputFrom.value || 0));
        sliderTo.value = Math.min(5000000, parseInt(inputTo.value || 5000000));

        handlePriceSliders();
    }

    function updatePriceDisplay() {
        var from = parseInt(document.getElementById('priceFromInput').value);
        var to = parseInt(document.getElementById('priceToInput').value);
        
        var display = document.getElementById('priceDisplay');
        display.innerHTML = 
            '<?= __('Từ') ?> <strong>' + new Intl.NumberFormat('vi-VN').format(from) + '₫</strong> ' +
            '<?= __('đến') ?> ' +
            '<strong>' + new Intl.NumberFormat('vi-VN').format(to) + '₫</strong>';
    }

    // Event Listeners cho sliders
    document.getElementById('priceSliderFrom').addEventListener('input', handlePriceSliders);
    document.getElementById('priceSliderTo').addEventListener('input', handlePriceSliders);

    // Toggle Filter Sections
    document.querySelectorAll('.filter-toggle').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            var filterSection = btn.closest('.filter-section');
            filterSection.classList.toggle('collapsed');
        });
    });

    // Function để apply filter
    window.filterSearch = function() {
        var selectedCategory = document.querySelector('input[name="cat"]:checked');
        var category = selectedCategory ? selectedCategory.value : '';
        var priceFrom = parseInt(document.getElementById('priceFromInput').value || 0);
        var priceTo = parseInt(document.getElementById('priceToInput').value || 5000000);
        
        // Build URL query string
        var url = new URL(window.location);
        
        if (category) {
            url.searchParams.set('cat', category);
        } else {
            url.searchParams.delete('cat');
        }
        
        if (priceFrom > 0 || priceTo < 5000000) {
            url.searchParams.set('price[from]', priceFrom);
            url.searchParams.set('price[to]', priceTo);
        } else {
            url.searchParams.delete('price[from]');
            url.searchParams.delete('price[to]');
        }
        
        window.location = url.toString();
    };

    // Initialize on load
    document.addEventListener('DOMContentLoaded', function() {
        handlePriceSliders();
    });
</script>

