<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Bookstore_Utility::css/utility.css"/>
    </head>
    <body>
        <attribute name="class" value="bookstore-utility-custom"/>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceContainer name="content">
            <block class="Bookstore\Utility\Block\Info" name="bookstore.utility.info" template="Bookstore_Utility::info.phtml"/>
        </referenceContainer>
    </body>
</page>