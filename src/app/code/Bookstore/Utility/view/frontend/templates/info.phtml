                    <article>
                        <a href="<?= $block->escapeUrl($item['link']) ?>" target="_blank" rel="noopener"><?= $block->escapeHtml($item['title']) ?></a>
                        <p><?= $block->escapeHtml(mb_substr($item['description'] ?? '', 0, 150)) ?></p>
