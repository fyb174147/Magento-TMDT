<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="bookstore_utility" translate="label" sortOrder="920" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Bookstore Utility</label>
            <tab>general</tab>
            <resource>Magento_Config::config</resource>
            <group id="weather" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>OpenWeatherMap</label>
                <field id="api_key" translate="label" type="obscure" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="city" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>City</label>
                </field>
            </group>
        </section>
    </system>
</config>
