<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/bookstore/catalog/products" method="GET">
        <service class="Bookstore\CoreApi\Api\CatalogInterface" method="getProducts"/>
        <resources><resource ref="anonymous"/></resources>
    </route>
    <route url="/V1/bookstore/catalog/categories" method="GET">
        <service class="Bookstore\CoreApi\Api\CatalogInterface" method="getCategories"/>
        <resources><resource ref="anonymous"/></resources>
    </route>
    <route url="/V1/bookstore/catalog/products/:productId" method="GET">
        <service class="Bookstore\CoreApi\Model\BookstoreApi" method="getProduct"/>
        <resources><resource ref="anonymous"/></resources>
    </route>
    <route url="/V1/bookstore/customer/me" method="GET">
        <service class="Bookstore\CoreApi\Api\CustomerInterface" method="me"/>
        <resources><resource ref="self"/></resources>
    </route>
    <route url="/V1/bookstore/customer/profile" method="GET">
        <service class="Bookstore\CoreApi\Model\BookstoreApi" method="getCustomerProfile"/>
        <resources><resource ref="self"/></resources>
    </route>
    <route url="/V1/bookstore/customer/orders" method="GET">
        <service class="Bookstore\CoreApi\Model\BookstoreApi" method="getCustomerOrders"/>
        <resources><resource ref="self"/></resources>
    </route>
    <route url="/V1/bookstore/orders" method="POST">
        <service class="Bookstore\CoreApi\Api\OrderRepositoryInterface" method="create"/>
        <resources><resource ref="self"/></resources>
    </route>
    <route url="/V1/bookstore/orders/:orderId" method="GET">
        <service class="Bookstore\CoreApi\Api\OrderRepositoryInterface" method="get"/>
        <resources><resource ref="self"/></resources>
    </route>
    <route url="/V1/bookstore/orders/:orderId/status" method="GET">
        <service class="Bookstore\CoreApi\Model\BookstoreApi" method="getOrderStatus"/>
        <resources><resource ref="self"/></resources>
    </route>
    <route url="/V1/bookstore/payments/vietqr/qr" method="GET">
        <service class="Bookstore\CoreApi\Model\BookstoreApi" method="getVietQr"/>
        <resources><resource ref="self"/></resources>
    </route>
</routes>
