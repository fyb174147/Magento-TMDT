# --- SENSITIVE FILES (BẢO MẬT TUYỆT ĐỐI) ---
auth.json
src/app/etc/env.php
.env
*.sql
*.gz

# --- DOCKER & OS ---
.DS_Store
Thumbs.db
.docker/data/
docker-compose.override.yml

# --- MAGENTO GENERATED & CACHE ---
src/var/*
src/generated/*
!src/generated/.gitkeep
src/pub/static/*
!src/pub/static/.htaccess

# --- DEPENDENCIES ---
src/vendor/
node_modules/

# --- TEMP & LOG FILES ---
*.log
*.swp
*.bak
.idea/
.vscode/

# --- Ignore demo images in any image/img folders ---
# Matches files or directories containing the word "demo" inside any images or img directory
**/images/**/*demo*
**/img/**/*demo*
**/images/**/demo/
**/img/**/demo/

# --- Ignore Magento product image cache (not needed in repo) ---
# Ignore the product image cache directory and its contents
src/pub/media/catalog/product/cache/
src/pub/media/catalog/product/cache/**

# --- ADDITIONAL MAGENTO IGNORES (tweaks for custom repo) ---
# Composer cache/home used during builds
src/composer_home/

# Local PHP built-in server files
phpserver/
src/phpserver/

# Node and build artifacts
.sass-cache/
.cache/

# Ensure page cache and other var subfolders remain ignored explicitly
src/var/cache/
src/var/page_cache/
src/var/composer_home/

custom_code_tree.txt
agent_rules.txt
